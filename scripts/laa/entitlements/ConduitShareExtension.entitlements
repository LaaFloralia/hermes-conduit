<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The LAA build's Share Extension leaves its draft in the launcher App
         Group, as the widgets read it. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.laa-inc.laa.launcher</string>
    </array>
</dict>
</plist>
