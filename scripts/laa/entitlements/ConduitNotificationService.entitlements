<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The LAA build's Notification Service Extension shares the LAA app's
         notification App Group (project-laa.yml). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.laa-inc.laa.notifications</string>
    </array>
</dict>
</plist>
