#!/bin/sh
# Thin wrapper so the CLI can be symlinked into ~/.local/bin.
target=$0
while [ -L "$target" ]; do
  dir=$(cd -P "$(dirname "$target")" && pwd)
  target=$(readlink "$target")
  case $target in
    /*) ;;
    *) target="$dir/$target" ;;
  esac
done
dir=$(cd -P "$(dirname "$target")" && pwd)
exec node "$dir/../src/cli.mjs" "$@"
